{
  "name": "venia-consent",
  "private": true,
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "bun run --filter='./packages/*' build",
    "dev": "bun run --filter='./packages/*' dev",
    "dev:next": "bun run --filter='./examples/next-app' dev",
    "lint": "oxlint . && oxfmt --check",
    "lint:fix": "oxlint . --fix && oxfmt --write",
    "format": "oxfmt --check",
    "format:write": "oxfmt --write"
  },
  "dependencies": {
    "@venia-consent/core": "workspace:*",
    "@venia-consent/react": "workspace:*",
    "@venia-consent/vue": "workspace:*",
    "@venia-consent/theme": "workspace:*",
    "@venia-consent/cli": "workspace:*"
  },
  "devDependencies": {
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  }
}
