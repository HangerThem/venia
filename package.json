{
	"name": "venia",
	"private": true,
	"workspaces": [
		"packages/*",
		"examples/*"
	],
	"dependencies": {
		"@venia/core": "workspace:*",
		"@venia/react": "workspace:*",
		"@venia/theme-default": "workspace:*"
	},
	"peerDependencies": {
		"typescript": "^5.0.0"
	},
	"scripts": {
		"build": "bun run --filter='./packages/*' build",
		"dev": "bun run --filter='./examples/next-app' dev"
	}
}